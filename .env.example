# Set these in the relevant process environment; .env is not loaded automatically.
# MCP client settings:
THINGS3_MCP_PROVIDER=auto
THINGS3_MCP_ALLOW_DIRECT_FALLBACK=0
# Must exceed 30 seconds; keep it above the configured worker deadline.
THINGS3_MCP_BRIDGE_TIMEOUT=35
# Optional path overrides; omit rather than setting an empty value.
# THINGS3_MCP_BRIDGE_SOCKET=/ABSOLUTE/PATH/TO/bridge.sock
# THINGS3_MCP_BRIDGE_TOKEN_FILE=/ABSOLUTE/PATH/TO/bridge.token
# THINGS3_MCP_CACHE_FILE=/ABSOLUTE/PATH/TO/cache/latest.json

# Bridge process settings:
THINGS3_MCP_BRIDGE_WORKER_TIMEOUT=30
# Optional folder hint if automatic database discovery fails (ThingsData-ABC123).
THINGS3_MCP_DATA_FOLDER=
# Retain request payloads only after deciding that private titles/notes may persist.
# Install with this explicit value to persist it in the LaunchAgent configuration.
THINGS3_MCP_BRIDGE_JOURNAL_PAYLOADS=0

# Standalone synthetic adapter process setting:
CLAWBRIDGE_JOURNAL_PAYLOADS=0
